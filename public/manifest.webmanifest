{
  "lang": "en",
  "dir": "ltr",
  "name": "LangSpot Learning Studio",
  "short_name": "LangSpot",
  "description": "A multilingual learning studio for structured study, vocabulary, grammar, pronunciation and offline progress.",
  "categories": [
    "education",
    "books",
    "reference",
    "utilities"
  ],
  "theme_color": "#173d35",
  "background_color": "#f5f6f3",
  "start_url": "./",
  "scope": "./",
  "id": "./?homescreen=1",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "icons": [
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-128.png",
      "sizes": "128x128",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-32.png",
      "sizes": "32x32",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Search vocabulary",
      "short_name": "Search",
      "description": "Search words, grammar and lessons.",
      "url": "./search/",
      "icons": [
        {
          "src": "icons/shortcut-search.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Research workspace",
      "short_name": "Research",
      "description": "Open the focused learning workspace.",
      "url": "./research/",
      "icons": [
        {
          "src": "icons/shortcut-research.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Dictionary",
      "short_name": "Dictionary",
      "description": "Browse vocabulary and meanings.",
      "url": "./dictionary/",
      "icons": [
        {
          "src": "icons/shortcut-dictionary.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My learning workspace",
      "short_name": "Workspace",
      "description": "Open progress and saved learning.",
      "url": "./workspace/",
      "icons": [
        {
          "src": "icons/shortcut-workspace.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "screenshots": [
    {
      "src": "screenshots/home-wide.svg",
      "sizes": "1280x720",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "LangSpot learning dashboard and language paths"
    },
    {
      "src": "screenshots/settings-wide.svg",
      "sizes": "1280x720",
      "type": "image/svg+xml",
      "form_factor": "wide",
      "label": "LangSpot settings, voice preferences and account features"
    },
    {
      "src": "screenshots/home-narrow.svg",
      "sizes": "390x844",
      "type": "image/svg+xml",
      "form_factor": "narrow",
      "label": "LangSpot responsive mobile learning dashboard"
    }
  ],
  "prefer_related_applications": false,
  "related_applications": [],
  "file_handlers": [
    {
      "action": "./handle-audio-file/",
      "accept": {
        "audio/wav": [
          ".wav"
        ],
        "audio/x-wav": [
          ".wav"
        ],
        "audio/mpeg": [
          ".mp3"
        ],
        "audio/mp4": [
          ".mp4",
          ".m4a"
        ],
        "audio/aac": [
          ".adts",
          ".aac"
        ],
        "audio/ogg": [
          ".ogg"
        ],
        "application/ogg": [
          ".ogg"
        ],
        "audio/webm": [
          ".webm"
        ],
        "audio/flac": [
          ".flac"
        ],
        "audio/mid": [
          ".rmi",
          ".mid"
        ]
      }
    }
  ],
  "launch_handler": {
    "client_mode": [
      "focus-existing",
      "auto"
    ]
  },
  "protocol_handlers": [
    {
      "protocol": "web+langspot",
      "url": "./protocol-handler/?url=%s"
    },
    {
      "protocol": "web+language",
      "url": "./protocol-handler/?url=%s"
    }
  ],
  "share_target": {
    "action": "./share-target/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "name",
      "text": "description",
      "url": "link",
      "files": [
        {
          "name": "texts",
          "accept": [
            "text/plain",
            "text/html",
            ".txt",
            ".html",
            ".md"
          ]
        },
        {
          "name": "audio",
          "accept": [
            "audio/*",
            ".mp3",
            ".wav",
            ".ogg",
            ".flac"
          ]
        },
        {
          "name": "images",
          "accept": [
            "image/*",
            ".svg"
          ]
        }
      ]
    }
  }
}
